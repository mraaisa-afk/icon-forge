{
  "productName": "Icon Forge",
  "version": "0.1.0",
  "identifier": "app.iconforge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Icon Forge",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Icon Forge",
    "shortDescription": "Offline icon sheet vectorizer, grouper and triage workspace",
    "longDescription": "Icon Forge vectorizes raster icon sheets into editable SVG, groups scattered icons into bounded units, levels them to a consistent set, and provides a keyboard-driven review workspace and sheet exporter. It runs entirely offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
